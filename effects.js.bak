/* ===== ALE IMMERSIVE MOTION ENGINE v3 ===== */
(() => {
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = window.matchMedia('(pointer:fine)').matches;

  const css = `
  :root{--ale-c1:#70f4e2;--ale-c2:#9c8cff;--ale-gold:#ffcf70}
  html{--scroll-progress:0%;scroll-behavior:auto}
  body{--mx:50vw;--my:50vh;--scroll-y:0px}
  .ale-progress{position:fixed;top:0;left:0;width:var(--scroll-progress);height:3px;z-index:10000;pointer-events:none;background:linear-gradient(90deg,var(--ale-c1),var(--ale-c2),var(--ale-gold),var(--ale-c1));background-size:220% 100%;animation:aleGradient 3s linear infinite;box-shadow:0 0 18px rgba(112,244,226,.8)}
  .ale-canvas{position:fixed;inset:0;width:100%;height:100%;z-index:-2;pointer-events:none;opacity:.7}
  .ale-vignette{position:fixed;inset:0;z-index:-1;pointer-events:none;background:radial-gradient(circle at 50% 35%,transparent 25%,rgba(0,0,0,.12) 75%,rgba(0,0,0,.3));mix-blend-mode:multiply}
  .ale-spotlight{position:fixed;width:520px;height:520px;left:0;top:0;z-index:0;pointer-events:none;border-radius:50%;background:radial-gradient(circle,rgba(112,244,226,.10),rgba(156,140,255,.035) 38%,transparent 70%);transform:translate3d(calc(var(--mx) - 260px),calc(var(--my) - 260px),0);mix-blend-mode:screen;transition:transform .12s ease-out}
  .ale-cursor,.ale-cursor-dot{position:fixed;border-radius:50%;pointer-events:none;z-index:10001;transform:translate(-50%,-50%);opacity:0;transition:opacity .25s ease}
  .ale-cursor{width:32px;height:32px;border:1px solid rgba(112,244,226,.55);box-shadow:0 0 20px rgba(112,244,226,.12);transition:width .2s,height .2s,border-color .2s,background .2s,opacity .25s}
  .ale-cursor-dot{width:5px;height:5px;background:#fff;box-shadow:0 0 12px var(--ale-c1)}
  body.ale-hovering .ale-cursor{width:48px;height:48px;border-color:rgba(255,207,112,.8);background:rgba(112,244,226,.04)}
  .ale-ribbon{position:fixed;width:42vw;height:9vw;min-width:280px;border-radius:50%;border:1px solid rgba(112,244,226,.10);pointer-events:none;z-index:0;filter:blur(.2px);animation:aleRibbon 14s ease-in-out infinite alternate}
  .ale-ribbon.r1{top:8%;left:-12%;transform:rotate(-12deg)}.ale-ribbon.r2{right:-12%;bottom:10%;transform:rotate(18deg);animation-delay:-6s;border-color:rgba(156,140,255,.11)}
  .ale-orb{position:fixed;width:7px;height:7px;border-radius:50%;background:var(--ale-c1);box-shadow:0 0 14px var(--ale-c1),0 0 30px rgba(112,244,226,.35);pointer-events:none;z-index:10001;opacity:0;transform:translate(-50%,-50%)}
  .ale-orb.show{opacity:.75}
  .ale-spark{position:fixed;width:2px;height:2px;border-radius:50%;background:#fff0bb;box-shadow:0 0 9px rgba(255,220,140,.9);pointer-events:none;z-index:1;animation:aleSpark var(--dur) linear infinite}
  .ale-page-flash{position:fixed;inset:0;z-index:9999;pointer-events:none;background:radial-gradient(circle at var(--fx) var(--fy),rgba(112,244,226,.16),transparent 23%);animation:aleFlash .55s ease-out forwards}
  .ale-transition{position:fixed;inset:0;z-index:10002;pointer-events:none;background:radial-gradient(circle at var(--tx) var(--ty),rgba(112,244,226,.16),rgba(8,14,20,.92) 48%,#05080c 100%);opacity:0;visibility:hidden;transition:opacity .14s ease,visibility 0s linear .14s}
  .ale-transition.active{opacity:1;visibility:visible;transition:opacity .14s ease}
  .ale-reveal{opacity:1;transform:none;filter:none;transition:none}
  .ale-reveal.is-visible{opacity:1;transform:none;filter:none}
  .ale-stagger>*{transition-delay:var(--delay,0ms)}
  .ale-tilt{transform-style:preserve-3d;will-change:transform}
  .ale-tilt>*{transform:translateZ(0)}
  .ale-shimmer{background:linear-gradient(110deg,currentColor 35%,#fff 50%,currentColor 65%);background-size:250% 100%;-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;animation:aleShimmer 4s linear infinite}
  .ale-glow-pulse{animation:aleGlow 2.6s ease-in-out infinite alternate}
  .ale-float{animation:aleFloat 5s ease-in-out infinite}
  .ale-breathing{animation:aleBreath 3.2s ease-in-out infinite}
  .btn,.buttons a,button,.menu-btn,.event-tab{position:relative;isolation:isolate;overflow:hidden;will-change:transform}
  .btn::after,.buttons a::after,button::after,.event-tab::after{content:'';position:absolute;inset:-30%;background:linear-gradient(115deg,transparent 42%,rgba(255,255,255,.18) 50%,transparent 58%);transform:translateX(-70%) rotate(8deg);transition:transform .75s ease;pointer-events:none;z-index:2}
  .btn:hover::after,.buttons a:hover::after,button:hover::after,.event-tab:hover::after{transform:translateX(70%) rotate(8deg)}
  .ripple{position:absolute!important;width:12px!important;height:12px!important;border-radius:50%!important;background:rgba(255,255,255,.5)!important;transform:translate(-50%,-50%) scale(0)!important;animation:aleRipple .7s ease-out forwards!important;pointer-events:none!important;z-index:5!important}
  .ale-click-ring{position:fixed;width:18px;height:18px;border:1px solid var(--ale-c1);border-radius:50%;pointer-events:none;z-index:10003;transform:translate(-50%,-50%);animation:aleClick .6s ease-out forwards}
  .event-card,.instruction-detail,.concept-box,.guidelines-box,.judging-item,.contact-grid>div,.schedule-list>div{position:relative;overflow:hidden}
  .event-card::after,.instruction-detail::after,.concept-box::after,.guidelines-box::after,.judging-item::after{content:'';position:absolute;width:190px;height:190px;border-radius:50%;left:var(--card-x,50%);top:var(--card-y,50%);transform:translate(-50%,-50%);background:radial-gradient(circle,rgba(112,244,226,.13),transparent 68%);opacity:0;transition:opacity .3s ease;pointer-events:none}
  .event-card:hover::after,.instruction-detail:hover::after,.concept-box:hover::after,.guidelines-box:hover::after,.judging-item:hover::after{opacity:1}
  input:focus,select:focus,textarea:focus{transform:translateY(-2px)!important;box-shadow:0 0 0 3px rgba(112,244,226,.09),0 12px 35px rgba(0,0,0,.2),0 0 24px rgba(112,244,226,.08)!important}
  .nav-scrolled{box-shadow:0 14px 45px rgba(0,0,0,.3)!important;backdrop-filter:blur(20px)!important}
  .ale-scroll-cue{animation:aleCue 1.8s ease-in-out infinite}
  @keyframes aleGradient{to{background-position:220% 0}}
  @keyframes aleRibbon{from{transform:translate3d(-3vw,0,0) rotate(-12deg) scale(.95)}to{transform:translate3d(10vw,5vh,0) rotate(9deg) scale(1.1)}}
  @keyframes aleSpark{0%{opacity:0;transform:translate3d(0,30px,0) scale(.4)}15%{opacity:.8}80%{opacity:.35}100%{opacity:0;transform:translate3d(var(--sx),-140px,0) scale(1.5)}}
  @keyframes aleFlash{from{opacity:1}to{opacity:0}}
  @keyframes aleRipple{to{transform:translate(-50%,-50%) scale(28)!important;opacity:0}}
  @keyframes aleClick{to{width:90px;height:90px;opacity:0}}
  @keyframes aleShimmer{to{background-position:250% 0}}
  @keyframes aleGlow{to{text-shadow:0 0 24px rgba(112,244,226,.3),0 0 50px rgba(156,140,255,.12)}}
  @keyframes aleFloat{50%{transform:translateY(-7px)}}
  @keyframes aleBreath{50%{transform:scale(1.018)}}
  @keyframes aleCue{50%{transform:translateY(6px);opacity:.55}}
  @media(max-width:800px){.ale-spotlight{width:300px;height:300px}.ale-ribbon{opacity:.5}.ale-cursor,.ale-cursor-dot{display:none}}
  @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.ale-canvas,.ale-vignette,.ale-spotlight,.ale-ribbon,.ale-orb,.ale-spark,.ale-cursor,.ale-cursor-dot{display:none!important}.ale-reveal{opacity:1!important;transform:none!important;filter:none!important}.ale-shimmer,.ale-glow-pulse,.ale-float,.ale-breathing{animation:none!important}}
  `;
  const style=document.createElement('style');style.id='ale-immersive-v3';style.textContent=css;document.head.appendChild(style);

  const progress=document.createElement('div');progress.className='ale-progress';document.body.appendChild(progress);
  const vignette=document.createElement('div');vignette.className='ale-vignette';document.body.appendChild(vignette);
  const transition=document.createElement('div');transition.className='ale-transition';document.body.appendChild(transition);
  const update=()=>{const max=Math.max(1,document.documentElement.scrollHeight-innerHeight);document.documentElement.style.setProperty('--scroll-progress',`${Math.min(100,scrollY/max*100)}%`);document.body.style.setProperty('--scroll-y',scrollY+'px');document.querySelectorAll('.navbar,header').forEach(n=>n.classList.toggle('nav-scrolled',scrollY>18));};
  addEventListener('scroll',update,{passive:true});update();

  if(!reduce){
    const spotlight=document.createElement('div');spotlight.className='ale-spotlight';document.body.appendChild(spotlight);
    const r1=document.createElement('div');r1.className='ale-ribbon r1';document.body.appendChild(r1);const r2=document.createElement('div');r2.className='ale-ribbon r2';document.body.appendChild(r2);

    // Animated particle field / wave-like constellation.
    const canvas=document.createElement('canvas');canvas.className='ale-canvas';document.body.appendChild(canvas);const ctx=canvas.getContext('2d');let w,h,dots=[];
    const resize=()=>{const dpr=Math.min(window.devicePixelRatio||1,1.5);w=canvas.width=innerWidth*dpr;h=canvas.height=innerHeight*dpr;canvas.style.width=innerWidth+'px';canvas.style.height=innerHeight+'px';ctx.setTransform(dpr,0,0,dpr,0,0);dots=Array.from({length:Math.min(48,Math.floor(innerWidth/22))},()=>({x:Math.random()*innerWidth,y:Math.random()*innerHeight,r:.5+Math.random()*1.5,v:(Math.random()-.5)*.16,p:Math.random()*Math.PI*2}));};resize();addEventListener('resize',resize);
    let tick=0,raf=0;const draw=()=>{if(document.hidden){raf=0;return}ctx.clearRect(0,0,innerWidth,innerHeight);tick+=.008;for(const p of dots){p.y-=p.v;p.x+=Math.sin(tick+p.p)*.08;if(p.y<-10)p.y=innerHeight+10;if(p.x<0)p.x=innerWidth;if(p.x>innerWidth)p.x=0;ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,Math.PI*2);ctx.fillStyle='rgba(112,244,226,.28)';ctx.fill()}raf=requestAnimationFrame(draw)};draw();document.addEventListener('visibilitychange',()=>{if(!document.hidden&&!raf)draw()});

    // Cursor-following, card-tilt, and pointer-movement effects removed.

    // Layered atmospheric particles.
    for(let i=0;i<30;i++){const s=document.createElement('i');s.className='ale-spark';s.style.left=Math.random()*100+'vw';s.style.top=(20+Math.random()*80)+'vh';s.style.setProperty('--sx',(-70+Math.random()*140)+'px');s.style.setProperty('--dur',(3+Math.random()*5)+'s');s.style.animationDelay=(-Math.random()*6)+'s';document.body.appendChild(s)}

    // Rich click feedback.
    document.addEventListener('click',e=>{const target=e.target.closest('.btn,.buttons a,button,.menu-btn,.event-tab,.navbar a,header a');if(!target)return;const b=target.getBoundingClientRect();const ripple=document.createElement('span');ripple.className='ripple';ripple.style.left=e.clientX-b.left+'px';ripple.style.top=e.clientY-b.top+'px';target.appendChild(ripple);setTimeout(()=>ripple.remove(),720);const ring=document.createElement('span');ring.className='ale-click-ring';ring.style.left=e.clientX+'px';ring.style.top=e.clientY+'px';document.body.appendChild(ring);setTimeout(()=>ring.remove(),650);const flash=document.createElement('div');flash.className='ale-page-flash';flash.style.setProperty('--fx',e.clientX+'px');flash.style.setProperty('--fy',e.clientY+'px');document.body.appendChild(flash);setTimeout(()=>flash.remove(),600)});

    // Stable internal navigation: event -> home is immediate so the home page is never hidden behind a transition.
    document.addEventListener('click',e=>{const a=e.target.closest('a[href]');if(!a||a.target==='_blank'||a.hasAttribute('download'))return;const href=a.getAttribute('href');if(!href||href.startsWith('#')||href.startsWith('mailto:')||href.startsWith('javascript:'))return;try{const u=new URL(href,location.href);if(u.origin!==location.origin)return;const returningHome=/\/index\.html(?:#|$)/i.test(u.pathname)||u.pathname.endsWith('/');if(returningHome)return;e.preventDefault();transition.style.setProperty('--tx',(e.clientX||innerWidth/2)+'px');transition.style.setProperty('--ty',(e.clientY||innerHeight/2)+'px');transition.classList.add('active');setTimeout(()=>location.assign(u.href),150)}catch(_){}},{capture:true});

    // Never leave the home page in a half-revealed state after browser back/forward or bfcache restore.
    const revealSelectors='.section,.event-card,.schedule-list > div,.contact-grid > div,.concept-box,.instructions-box,.guidelines-box,.instruction-detail,.judging-item,.registration-page,#login,#dashboard,.event-panel,.event-panel-intro,#register,.hero-content';
    const els=[...document.querySelectorAll(revealSelectors)];
    els.forEach(el=>{el.classList.add('ale-reveal');el.classList.add('is-visible')});
    addEventListener('pageshow',()=>{transition.classList.remove('active');els.forEach(el=>el.classList.add('is-visible'));requestAnimationFrame(update)});

    document.querySelectorAll('.scroll').forEach(x=>x.classList.add('ale-scroll-cue'));
    document.querySelectorAll('.hero h1,.moving-title,.section-title').forEach(x=>x.classList.add('ale-glow-pulse'));
    document.querySelectorAll('.section-label,.event-category').forEach(x=>x.classList.add('ale-shimmer'));
    document.querySelectorAll('.event-card .icon').forEach(x=>x.classList.add('ale-breathing'));
  } else {document.querySelectorAll('.hero h1,.moving-title,.section-title').forEach(x=>x.style.animation='none')}

  // Active tabs get a tactile pulse.
  document.querySelectorAll('.event-tab').forEach(tab=>tab.addEventListener('click',()=>tab.animate([{transform:'scale(.96)'},{transform:'scale(1.045)'},{transform:'scale(1)'}],{duration:380,easing:'cubic-bezier(.2,.8,.2,1)'})));
})();
