const EVENT_INSTRUCTIONS={
  "KALARAVA": {
    details: [
      ["Team Size", "Minimum 6 and maximum 10 participants."],
      ["Time Limit", "Maximum 10 minutes, including stage setup."]
    ],
    rules: [
      "The performance should have a clear connection with Coastal Karnataka and its cultural identity.",
      "Teams are free to combine different performing-art forms.",
      "Use of fire, hazardous substances or any item that may damage the stage is prohibited.",
      "Vulgar, offensive, discriminatory or inappropriate content will lead to disqualification.",
      "Exceeding the prescribed time limit may attract deduction of marks.",
