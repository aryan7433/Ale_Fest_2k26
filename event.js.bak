const EVENTS={
"KALARAVA": ["CULTURAL PROGRAM", "CULTURAL", "dance", "A celebration of culture, creativity and live performances.", `A team-based cultural presentation showcasing the art, traditions, lifestyle, heritage or changing identity of Coastal Karnataka.`, ["Dance","Drama / Skit","Folk Song","Mime","Yakshagana elements","Traditional art forms","Local dialects"]],
"REEL-THE-KARAVALI": ["REEL MAKING", "INDIVIDUAL / TEAM", "film", "Create a compelling reel inspired by the spirit of Karavali.", `Participants shall create a short reel presenting Coastal Karnataka through the perspective of today's generation.`, ["Traditions","Food","Occupations","Village life","Folk arts","Environment","Language","Forgotten practices","The changing face of Karavali"]],
"EREG GOTUNDU": ["QUIZ", "TEAM", "quiz", "Test your knowledge, teamwork and quick thinking in an exciting quiz."],
"BATTLE ARENA": ["FREE FIRE TOURNAMENT", "TEAM", "gaming", "Compete in the Free Fire tournament and battle for victory."],
"KARAVALI QUEST": ["TREASURE HUNT", "TEAM", "treasure", "Follow clues, solve puzzles and uncover the hidden treasure.", `A team-based treasure hunt consisting of clues, puzzles and activity rounds connected with Coastal Karnataka, along with general logical and observational challenges.`, [], `QR codes and mobile phones may be incorporated into selected rounds.`]
};

