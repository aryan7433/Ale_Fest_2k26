      "Copyrighted material should be avoided unless legitimately available for such use.",
      "Offensive, political, obscene or discriminatory content shall not be permitted.",
      "Reels shall be submitted within the deadline prescribed by the organisers.",
      "Decision of the judges shall be final."
    ],
    judging: [
      ["Relevance to Theme", "30%"],
      ["Creativity", "25%"],
      ["Storytelling / Message", "20%"],
      ["Technical Presentation", "15%"],
      ["Overall Impact", "10%"]
    ]
  },
  "KARAVALI QUEST": {
    details: [
      ["Team Size", "4 participants per team."]
    ],
    rules: [
      "Participants may use mobile phones only when permitted by the organisers.",
      "Clues, QR codes, checkpoints or any material placed by the organisers shall not be removed, altered or damaged.",
      "Teams shall follow the prescribed route and checkpoint sequence.",
      "Any team found sharing clues or answers with another team may be disqualified.",
      "The winning positions shall be determined based on successful completion of tasks and prescribed time.",
      "In case of a tie, performance in the designated tie-breaker clue/task shall determine the result.",
      "Decision of the event coordinators shall be final."
    ]
  },
  "BATTLE ARENA": {
    details: [],
    rules: [
      "Hacking, cheating, modified applications, scripts or any unfair means will result in immediate disqualification.",
